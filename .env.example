# Copy to .env and fill in real values. .env is gitignored.
# Real environment variables take precedence over .env (override=False).

# --- TokenRouter (idea + caption + image generation) ---
TOKENROUTER_API_KEY=

# --- ImageKit (CDN upload + caption/description metadata) ---
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/salt

# --- Airtable (optional: log each pipeline run as a record) ---
# Personal access token with data.records:write (and schema.bases:write
# if you want the additive ensure-schema step to create missing fields).
AIRTABLE_API_KEY=
# Base id (starts with "app...") and the target table name or id.
AIRTABLE_BASE_ID=appYyBCWQlkLLMAX4
AIRTABLE_TABLE_NAME=Posts