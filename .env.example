# Copy to .env and fill in real values. .env is gitignored.
# Real environment variables take precedence over .env (override=False).

# --- TokenRouter (idea + caption + image generation) ---
TOKENROUTER_API_KEY=

# --- ImageKit (CDN upload + caption/description metadata) ---
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/salt

# --- HiveMQ Cloud (publish each post as the hand-off to the agent) ---
# Broker host + credentials (required unless --no-hivemq).
HIVEMQ_HOST=
HIVEMQ_USERNAME=
HIVEMQ_PASSWORD=
# Optional: TLS port (default 8883), topic (default tiktok/posts), client id.
HIVEMQ_PORT=8883
HIVEMQ_TOPIC=tiktok/posts
HIVEMQ_CLIENT_ID=

# --- TikTok account (optional "Account" field on every published post) ---
# The @handle the downstream tiktok-agent should switch to before posting.
# Omit / empty = post as the currently-active account. If the account can't
# be made active, the agent reports "wrong_account" and does not post.
#
# Resolution order (first non-empty wins):
#   1. --account <HANDLE> on the CLI  (tiktok-pipeline / tiktok-publish / hivemq-publish)
#   2. TIKTOK_ACCOUNT_<UPPER(profile)> env var  (per-profile default, set below)
#   3. TIKTOK_ACCOUNT env var                  (generic fallback)
#
# Per-profile defaults — set these to the @handle for each profile:
TIKTOK_ACCOUNT_GANI=@captgani
TIKTOK_ACCOUNT_KALILA=@likaliku.skin
# Generic fallback (used when no profile is set, or no per-profile var matches):
TIKTOK_ACCOUNT=